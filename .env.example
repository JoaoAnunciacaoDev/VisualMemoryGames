ENVIRONMENT=development

RAWG_API_KEY=your_rawg_api_key
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
STEAM_API_KEY=your_steam_api_key
SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_EXPIRE_DAYS=7
ALGORITHM=HS256
VITE_API_URL=http://localhost:8000
# Em produção no Render, prefira a Internal Database URL da mesma região.
DATABASE_URL=postgresql://user:pass@host/dbname
INTERNAL_CRON_SECRET=replace_with_a_random_internal_secret
JOB_POLL_SECONDS=10
JOB_LEASE_MINUTES=30
STEAM_SYNC_CONCURRENCY=4
HTTP_MAX_ATTEMPTS=3
RECOMMENDATION_CANDIDATES=150
LOG_FORMAT=json

# PostgreSQL pool (Render free: mantenha valores pequenos e um único worker)
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300
DB_STATEMENT_TIMEOUT_MS=30000
DB_SLOW_QUERY_MS=500

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Configuration (local or s3)
STORAGE_PROVIDER=local
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_BUCKET=your_bucket_name
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=your_s3_compatible_endpoint_url_if_using_s3
STORAGE_PUBLIC_BASE_URL=your_public_bucket_or_cdn_url_if_needed

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_FROM=seu-email@gmail.com

# Resend Configuration
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=noreply@seudominio.com

# BREVO Configuration
BREVO_API_KEY=your_brevo_api_key
